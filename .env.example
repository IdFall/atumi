# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais committer .env.local.

# Supabase (Paramètres du projet > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : serveur uniquement, contourne RLS
SUPABASE_SECRET_KEY=

# Connexion Postgres directe, utilisée par la file de tâches (pg-boss)
DATABASE_URL=postgresql://postgres:motdepasse@db.xxxx.supabase.co:5432/postgres

# Fournisseur IA
ANTHROPIC_API_KEY=
# Modèle principal (tuteur, synthèses) et modèle léger (classement, QCM)
ATUMI_AI_MODEL=claude-opus-5-5
ATUMI_AI_MODEL_LIGHT=claude-opus-5-5

# Centre d'aide : envoi à l'équipe des messages « Écrire à l'équipe » (worker).
# Chaque canal est facultatif ; sans réglages, les messages restent dans la table support_requests.
# E-mail (Resend) : adresse d'envoi d'un domaine vérifié, destinataires séparés par des virgules
RESEND_API_KEY=
SUPPORT_EMAIL_FROM=ATUMI <aide@exemple.com>
SUPPORT_EMAIL_TO=
# WhatsApp Business (API Cloud de Meta) : numéros destinataires au format +221..., séparés par des virgules.
# Le modèle de message doit être approuvé par Meta, avec 3 variables : n° de demande, utilisateur et contact, message.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SUPPORT_WHATSAPP_TO=
SUPPORT_WHATSAPP_TEMPLATE=atumi_demande_aide
SUPPORT_WHATSAPP_LANGUAGE=fr

# Numéros de l'équipe pour les paiements mobile money, par pays et par moyen (page « S'abonner »).
# Facultatif : sans numéro, la page invite à écrire à l'équipe.
ATUMI_PAYMENT_NUMBERS={"SN":{"wave":"+221 77 000 00 00","orange_money":"+221 78 000 00 00"}}
