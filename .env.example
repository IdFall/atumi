# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais committer .env.local.

# Supabase (Paramètres du projet > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : serveur uniquement, contourne RLS
SUPABASE_SECRET_KEY=

# Connexion Postgres directe, utilisée par la file de tâches (pg-boss)
DATABASE_URL=postgresql://postgres:motdepasse@db.xxxx.supabase.co:5432/postgres

# Fournisseur IA
ANTHROPIC_API_KEY=
# Modèle principal (tuteur, synthèses) et modèle léger (classement, QCM)
ATUMI_AI_MODEL=claude-opus-5-5
ATUMI_AI_MODEL_LIGHT=claude-opus-5-5
